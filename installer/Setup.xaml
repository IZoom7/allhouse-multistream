<!-- Allhouse Setup window. Loaded at runtime with XamlReader (csc has no XAML compiler); Setup.cs wires it up by x:Name. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Allhouse Setup" Width="720" Height="480" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Leelawadee UI, Segoe UI" FontSize="14" Foreground="#302C26">
  <Window.Resources>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Leelawadee UI</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Raised plastic key that presses down (same feel as .button in src/retro.css). -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="#F5EDD7"/>
      <Setter Property="Foreground" Value="#302C26"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="20,9"/>
      <Setter Property="MinWidth" Value="104"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="g" Margin="0,0,0,4">
              <Border x:Name="drop" CornerRadius="5" Background="#514738" Margin="0,4,0,-4"/>
              <Border x:Name="face" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="#514738" BorderThickness="2">
                <Border BorderBrush="#40FFFFFF" BorderThickness="0,2,0,0" CornerRadius="3">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                </Border>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="g" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-1"/></Setter.Value></Setter>
                <Setter TargetName="face" Property="Opacity" Value="0.93"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="face" Property="BorderBrush" Value="#285BB5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="g" Property="RenderTransform"><Setter.Value><TranslateTransform Y="3"/></Setter.Value></Setter>
                <Setter TargetName="drop" Property="Visibility" Value="Hidden"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="g" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#8D2832"/>
      <Setter Property="Foreground" Value="#FFF5DD"/>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- Title bar buttons -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="#F5EDD7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="10,0" MinWidth="34">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#6B5F4C"/></Trigger>
              <Trigger Property="Tag" Value="close">
                <Setter Property="Foreground" Value="#F5EDD7"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="close"/></MultiTrigger.Conditions>
                <Setter TargetName="b" Property="Background" Value="#BD3933"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Toggle switch, like .toggle in the app -->
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#302C26"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="box" Width="40" Height="22" CornerRadius="4" Background="#C9BEA2" BorderBrush="#514738" BorderThickness="2" VerticalAlignment="Center">
                <Border x:Name="knob" Width="14" Height="14" CornerRadius="2" Background="#F5EDD7" BorderBrush="#514738" BorderThickness="1.5" HorizontalAlignment="Left" Margin="2,0"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="#8D2832"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#285BB5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <!-- Hard retro drop shadow + soft ambient shadow -->
    <Border CornerRadius="10" Background="#514738" Margin="0,7,0,-7"/>
    <Border CornerRadius="10" Background="#E6DCC0" BorderBrush="#514738" BorderThickness="2">
      <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.30"/></Border.Effect>
    </Border>
    <Border CornerRadius="10" BorderThickness="2" BorderBrush="Transparent">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="38"/>
          <RowDefinition Height="5"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border x:Name="TitleBar" Background="#514738" CornerRadius="8,8,0,0">
          <DockPanel LastChildFill="False" Margin="12,0,6,0">
            <Image x:Name="TitleIcon" Width="20" Height="20" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Text="ALLHOUSE SETUP" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="13" Foreground="#F5EDD7" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="CloseBtn" DockPanel.Dock="Right" Tag="close" Style="{StaticResource Chrome}" Height="28" VerticalAlignment="Center">
              <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="11"/>
            </Button>
            <Button x:Name="MinBtn" DockPanel.Dock="Right" Style="{StaticResource Chrome}" Height="28" VerticalAlignment="Center">
              <TextBlock Text="&#xE921;" FontFamily="{StaticResource Icons}" FontSize="11"/>
            </Button>
            <Button x:Name="LangBtn" DockPanel.Dock="Right" Style="{StaticResource Chrome}" Height="28" VerticalAlignment="Center" Margin="0,0,6,0">
              <TextBlock x:Name="LangText" Text="TH / EN" FontFamily="{StaticResource Mono}" FontSize="12" FontWeight="Bold"/>
            </Button>
          </DockPanel>
        </Border>

        <!-- Controller stripe -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Rectangle Fill="#285BB5"/><Rectangle Grid.Column="1" Fill="#BD3933"/><Rectangle Grid.Column="2" Fill="#F0CB45"/><Rectangle Grid.Column="3" Fill="#287B49"/>
        </Grid>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

          <!-- Art: the pixel house floats, smoke rises from the chimney -->
          <Border Background="#C9BEA2" BorderBrush="#514738" BorderThickness="0,0,2,0" CornerRadius="0,0,0,8" ClipToBounds="True">
            <Grid>
              <Rectangle>
                <Rectangle.Fill>
                  <DrawingBrush TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                      <GeometryDrawing Brush="#B0A283"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,2,2"/></GeometryDrawing.Geometry></GeometryDrawing>
                    </DrawingBrush.Drawing>
                  </DrawingBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Canvas Width="200" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,0">
                <Ellipse x:Name="Shadow" Canvas.Left="40" Canvas.Top="206" Width="120" Height="14" Fill="#55514738" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><ScaleTransform x:Name="ShadowScale"/></Ellipse.RenderTransform>
                </Ellipse>
                <Canvas x:Name="Floater" Width="200" Height="210">
                  <Canvas.RenderTransform><TranslateTransform x:Name="FloatY"/></Canvas.RenderTransform>
                  <Rectangle x:Name="Puff1" Canvas.Left="150" Canvas.Top="26" Width="9" Height="9" Fill="#F5EDD7" Stroke="#514738" StrokeThickness="1.5" Opacity="0"><Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform></Rectangle>
                  <Rectangle x:Name="Puff2" Canvas.Left="154" Canvas.Top="26" Width="7" Height="7" Fill="#F5EDD7" Stroke="#514738" StrokeThickness="1.5" Opacity="0"><Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform></Rectangle>
                  <Rectangle x:Name="Puff3" Canvas.Left="147" Canvas.Top="26" Width="6" Height="6" Fill="#F5EDD7" Stroke="#514738" StrokeThickness="1.5" Opacity="0"><Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform></Rectangle>
                  <Image x:Name="Logo" Canvas.Left="10" Canvas.Top="20" Width="180" Height="180" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0.5,0.6">
                    <Image.RenderTransform><ScaleTransform x:Name="LogoScale"/></Image.RenderTransform>
                  </Image>
                </Canvas>
                <!-- Pixel sparkles for the finish -->
                <Canvas x:Name="Sparkles" Width="200" Height="250" IsHitTestVisible="False"/>
              </Canvas>
              <Border x:Name="OnAir" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22" Background="#F5EDD7" BorderBrush="#514738" BorderThickness="2" CornerRadius="4" Padding="10,3">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="OnAirDot" Width="8" Height="8" Fill="#287B49" VerticalAlignment="Center"/>
                  <TextBlock x:Name="OnAirText" Text="READY" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- Right column: one panel visible at a time -->
          <Grid Grid.Column="1" Margin="30,24,30,22">
            <Grid.RenderTransform><TranslateTransform x:Name="PanelY"/></Grid.RenderTransform>

            <!-- Welcome / confirm -->
            <DockPanel x:Name="PanelStart">
              <StackPanel DockPanel.Dock="Top">
                <Border HorizontalAlignment="Left" Background="#F0CB45" BorderBrush="#514738" BorderThickness="1.5" CornerRadius="3" Padding="8,1">
                  <TextBlock x:Name="Chip" FontFamily="{StaticResource Mono}" FontSize="11.5" FontWeight="Bold" Foreground="#332B17"/>
                </Border>
                <TextBlock x:Name="StartTitle" FontSize="27" FontWeight="Bold" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="StartBody" Foreground="#5D5444" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="21"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="StartSecondary" Style="{StaticResource Btn}" Margin="0,0,10,0"/>
                <Button x:Name="StartPrimary" Style="{StaticResource Primary}" IsDefault="True"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <StackPanel x:Name="PathRow">
                  <TextBlock x:Name="PathLabel" FontSize="12" FontWeight="Bold" Foreground="#5D5444" Margin="0,0,0,5"/>
                  <Border Background="#F5EDD7" BorderBrush="#89795D" BorderThickness="2" CornerRadius="5" Padding="10,6,6,6">
                    <DockPanel>
                      <Button x:Name="BrowseBtn" DockPanel.Dock="Right" Style="{StaticResource Small}" Margin="8,4,0,0"/>
                      <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#8D2832" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock x:Name="PathText" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </Border>
                </StackPanel>
                <CheckBox x:Name="Opt1" Margin="0,16,0,0" IsChecked="True"/>
                <CheckBox x:Name="Opt2" Margin="0,10,0,0" IsChecked="True"/>
              </StackPanel>
            </DockPanel>

            <!-- Working -->
            <StackPanel x:Name="PanelWork" Visibility="Collapsed" VerticalAlignment="Center">
              <TextBlock x:Name="WorkTitle" FontSize="27" FontWeight="Bold"/>
              <Border Background="#F5EDD7" BorderBrush="#89795D" BorderThickness="2" CornerRadius="6" Padding="12,10" Margin="0,14,0,0" MinHeight="64">
                <DockPanel x:Name="TipBox">
                  <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="5" Background="#8D2832" BorderBrush="#514738" BorderThickness="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TipIcon" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="#FFF5DD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock x:Name="TipText" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#302C26"/>
                </DockPanel>
              </Border>
              <Border x:Name="BarTrack" Height="30" Margin="0,22,0,0" CornerRadius="5" Background="#C9BEA2" BorderBrush="#514738" BorderThickness="2">
                <Grid ClipToBounds="True" Margin="1">
                  <Grid x:Name="BarFill" HorizontalAlignment="Left" Width="0" ClipToBounds="True">
                    <Rectangle x:Name="BarColors"/>
                    <Rectangle x:Name="Shine" Width="70" HorizontalAlignment="Left">
                      <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#99FFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                      </Rectangle.Fill>
                      <Rectangle.RenderTransform><TranslateTransform x:Name="ShineX"/></Rectangle.RenderTransform>
                    </Rectangle>
                  </Grid>
                  <!-- CRT scanlines over the whole bar -->
                  <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                      <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                          <GeometryDrawing Brush="#26000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,1.5"/></GeometryDrawing.Geometry></GeometryDrawing>
                        </DrawingBrush.Drawing>
                      </DrawingBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                </Grid>
              </Border>
              <DockPanel Margin="0,10,0,0">
                <TextBlock x:Name="Percent" DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="26" FontWeight="Bold" Text="0%" Foreground="#8D2832"/>
                <TextBlock x:Name="WorkFile" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="#6F6553" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
              </DockPanel>
            </StackPanel>

            <!-- Finished / error -->
            <DockPanel x:Name="PanelEnd" Visibility="Collapsed">
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="EndSecondary" Style="{StaticResource Btn}" Margin="0,0,10,0"/>
                <Button x:Name="EndPrimary" Style="{StaticResource Primary}" IsDefault="True"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <Border x:Name="EndBadge" Width="56" Height="56" CornerRadius="8" HorizontalAlignment="Left" Background="#287B49" BorderBrush="#514738" BorderThickness="2" RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="BadgeScale"/><TranslateTransform x:Name="BadgeX"/></TransformGroup></Border.RenderTransform>
                  <TextBlock x:Name="EndIcon" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="#FFF5DD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="EndTitle" FontSize="27" FontWeight="Bold" Margin="0,16,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="EndBody" Foreground="#5D5444" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="21"/>
              </StackPanel>
            </DockPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
