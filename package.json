{
  "name": "allhouse",
  "version": "0.1.0",
  "private": true,
  "description": "Allhouse — your stream, together. Local desktop alpha.",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1",
    "package": "tsc -b && vite build && electron-packager . Allhouse --platform=win32 --arch=x64 --out=release --overwrite --icon=public/brand/allhouse.ico --ignore=\"^/(release|tests|\\.git|\\.cache|\\.pnpm-store|test-results|QA|artifacts|design)($|/)\"",
    "test": "node --test \"tests/*.test.cjs\"",
    "app": "tsc -b && vite build && electron .",
    "release": "node scripts/build-release.cjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.6",
    "@fontsource/noto-sans-thai": "^5.2.5",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
